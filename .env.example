NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=https://technical.wirenet.ie
# 32-byte key used to encrypt MFA secrets at rest. Generate with: openssl rand -hex 32
TOTP_ENC_KEY=
TOTP_ISSUER=WireNet Technical
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
DATA_DIR=/var/lib/technical-wirenet
# Optional: override the category list (comma-separated)
# TASK_CATEGORIES=Networking,Structured Cabling,Wireless,Security & CCTV,Cloud & Microsoft 365,Servers & Virtualisation,Cybersecurity,Telephony & VoIP,Support & Maintenance,Other
